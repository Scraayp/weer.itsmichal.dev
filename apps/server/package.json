{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- npx --yes auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "^11.18.0",
    "@weer.itsmichal.dev/api": "*",
    "@weer.itsmichal.dev/auth": "*",
    "@weer.itsmichal.dev/db": "*",
    "better-auth": "1.7.5",
    "fastify": "^5.12.3",
    "varlock": "1.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@weer.itsmichal.dev/config": "*",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
